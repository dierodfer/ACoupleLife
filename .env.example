# Credenciales de Google Cloud (proyecto propio, pantalla de consentimiento en modo "Externo / En pruebas"
# con los dos emails de la pareja como usuarios de prueba).
#
# 1. Client ID de tipo "Aplicación web".
#    Orígenes autorizados de JavaScript:
#      - http://localhost:5173
#      - https://<usuario>.github.io
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# 2. Clave de API restringida a la Google Picker API. Solo la usa el selector de archivos
#    del segundo usuario ("Conectar archivo existente").
VITE_GOOGLE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
