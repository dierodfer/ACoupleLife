{
  "compilerOptions": {
    "target": "ES2022",
    // DOM además de Node: las funciones que van dentro de `page.evaluate` se
    // ejecutan en el navegador, con `navigator`, `caches` y `window`.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["playwright.config.ts", "pruebas-e2e"]
}
